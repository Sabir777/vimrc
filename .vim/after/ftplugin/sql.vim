" -----------------------------Отступы--------------------------------"
setlocal tabstop=4
setlocal shiftwidth=4
setlocal smarttab
setlocal expandtab
setlocal smartindent

" ------------------Автозавершение парных символов--------------------"
inoremap <buffer> ` ``<left>
inoremap <buffer> ' ''<left>
inoremap <buffer> ( ()<left>
